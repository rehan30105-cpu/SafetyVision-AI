# ==============================================================================
# SAFETYVISION AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to ".env" for local development.
# 2. Never commit the real ".env" file or real secrets to source control.
# 3. For cloud deployment (e.g. Render), configure these under Dashboard -> Environment.
# ==============================================================================

# --- Application Security & Server ---
APP_ENV=production
SECRET_KEY=replace_with_a_long_random_64_character_hex_key
PORT=5000
PUBLIC_BASE_URL=https://your-app-name.onrender.com
SESSION_COOKIE_SECURE=true
DEMO_ACTIVATION_MAX_AGE=86400
MAX_CONCURRENT_VIDEO_JOBS=2

# --- PPE Violation & Report Telegram Bot (Outbound Reports) ---
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=replace_with_ppe_bot_token
TELEGRAM_CHAT_ID=replace_with_target_chat_or_channel_id
TELEGRAM_ENABLED=true

# --- Private Demo-Request Approval Telegram Bot (Interactive Buttons) ---
# Can use a dedicated bot token or the same bot token as above
TELEGRAM_APPROVAL_BOT_TOKEN=replace_with_approval_bot_token
TELEGRAM_APPROVAL_CHAT_ID=replace_with_admin_private_chat_id
TELEGRAM_APPROVAL_ADMIN_USER_ID=replace_with_admin_telegram_numeric_user_id
TELEGRAM_APPROVAL_WEBHOOK_SECRET=replace_with_random_alphanumeric_secret
TELEGRAM_APPROVAL_ENABLED=true

# Polling vs Webhook:
# - On local machines (no public HTTPS): set TELEGRAM_APPROVAL_POLLING_ENABLED=true
#   and run "python run_telegram_approval_poller.py".
# - On Render (with public HTTPS URL): set TELEGRAM_APPROVAL_POLLING_ENABLED=false
#   and register Telegram webhook to: https://<domain>/telegram/demo-approval/webhook
TELEGRAM_APPROVAL_POLLING_ENABLED=false

# --- Brevo Transactional Email Service ---
BREVO_API_KEY=replace_with_brevo_v3_api_key
MAIL_FROM_EMAIL=notifications@yourdomain.com
MAIL_FROM_NAME=SafetyVision AI
ADMIN_EMAIL=admin@yourdomain.com
